<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="clr-namespace:Sift.Services"
             x:Class="Sift.Pages.ReviewPage"
             Title="{x:Static s:Strings.TabReview}">
    <Grid RowDefinitions="Auto,Auto,*">
        <!-- small toolbar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="12,6"
              BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1f2328}">
            <Button Grid.Column="0" Text="{x:Static s:Strings.Home}" Style="{StaticResource Secondary}" Clicked="OnHome" Padding="12,4" MinimumHeightRequest="36" FontSize="13" />
            <Label x:Name="ServerLabel" Grid.Column="1" Style="{StaticResource Muted}" VerticalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
            <Button Grid.Column="2" Text="{x:Static s:Strings.Reload}" Style="{StaticResource Secondary}" Clicked="OnReload" Padding="12,4" MinimumHeightRequest="36" FontSize="13" />
        </Grid>
        <ProgressBar x:Name="LoadBar" Grid.Row="1" IsVisible="False" HeightRequest="3" />

        <WebView x:Name="Web" Grid.Row="2" Navigating="OnNavigating" Navigated="OnNavigated" />

        <!-- not connected overlay -->
        <VerticalStackLayout x:Name="NotConnected" Grid.Row="2" Padding="24" Spacing="12" VerticalOptions="Center" IsVisible="False"
                             BackgroundColor="{AppThemeBinding Light=#f3f4f6, Dark=#111418}">
            <Label Text="{x:Static s:Strings.ConnectFirst}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
            <Button Text="{x:Static s:Strings.GoConnect}" Clicked="OnGoConnect" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
