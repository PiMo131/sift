        <ShellContent Title="Verbinden" Route="connect" ContentTemplate="{DataTemplate pages:ConnectPage}" />
        <ShellContent Title="Opname sturen" Route="upload" ContentTemplate="{DataTemplate pages:UploadPage}" />
        <ShellContent Title="Nakijken" Route="review" ContentTemplate="{DataTemplate pages:ReviewPage}" />
    </TabBar>
</Shell>
